# Copy to deploy/.env and fill in. deploy/.env is ignored by git: never commit it.

# The hub's token: at least 24 random characters (the web app asks for it; with an account it is the
# recovery key).
# Empty: Orbis makes one at the first start; read it with
#   docker compose exec orbis cat /data/token
ORBIS_TOKEN=

# Your Claude plan's token, from `claude setup-token` on a computer signed in to Claude (Pro or Max).
# Claude Code then runs on the plan's limits, never on API credits. Empty: paste it later in
# Settings → Brains → Claude Code. Personal use only: do not share it.
CLAUDE_CODE_OAUTH_TOKEN=

# Only for `--profile https` (scripts/server/orbis-server.sh fills these): the address Orbis is opened at —
# your domain, or <your-public-ip-with-dashes>.sslip.io — and the same with https:// for the hub.
ORBIS_DOMAIN=
ORBIS_PUBLIC_URL=

# Your Orbis account's email (confirmed in Supabase): the hub opens with that account's sign-in and links
# to it the first time, with no token to copy. Empty: sign in with the token and link it in Settings → Account.
ORBIS_OWNER_EMAIL=

# Your time zone, for routines (for example America/Sao_Paulo).
TZ=UTC
# The port on this machine.
ORBIS_PORT=7420
