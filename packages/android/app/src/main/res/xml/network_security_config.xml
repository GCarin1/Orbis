<?xml version="1.0" encoding="utf-8"?>
<!-- The hub usually runs on the user's own computer, reached at a local address over plain http
     (http://192.168.x.y:7420): the app allows it, as a browser on the same network does. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
