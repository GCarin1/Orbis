<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The hub: on this phone (127.0.0.1, inside Termux), or another Orbis over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Starting the hub on this phone: Termux runs `orbis-phone serve` when the app asks (RUN_COMMAND). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- A bot's reply, approval or secret request while the app is off screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Stay connected with the app closed": a foreground service keeps the page's connection alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The user's health data from Health Connect, read only and only what they allow (specs/health). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />

    <!-- The phone's speech recognizer and voice (Android 11+ hides other apps unless they are named here). -->
    <queries>
        <!-- Whether Termux is installed, and its RunCommandService. -->
        <package android:name="com.termux" />
        <!-- Health Connect, on Android 13 and older. -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbis">

        <!-- Google Play downloads its QR code scanner with the app, so the first scan does not wait. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" from another app: the text goes to a message box (a sign-in link connects). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Why Orbis reads health data: Health Connect shows it from its permission screen (Android 13 and older)… -->
        <activity
            android:name=".HealthPrivacyActivity"
            android:exported="true"
            android:label="@string/health_privacy_title">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- …and from the system's permission settings (Android 14 and newer). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Termux's answer when the hub's command ends (a start that failed, a hub that stopped). -->
        <receiver
            android:name=".TermuxResult"
            android:exported="false" />

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to the user's self-hosted Orbis hub open, at the user's request, to notify when a bot replies or needs an approval" />
        </service>
    </application>
</manifest>
