# Orbis — environment variables (see .doctrina/contracts/hub-surface.md).
# Every variable is optional; an empty value means "use the default".

# Hub
ORBIS_PORT=7420
ORBIS_HOST=127.0.0.1
ORBIS_DATA_DIR=
ORBIS_TOKEN=
ORBIS_MASTER_KEY=
ORBIS_MAX_BOTS=50
ORBIS_MAX_GROUP_SIZE=6
ORBIS_MAX_HANDOFF_DEPTH=6
ORBIS_ABSENCE_PAUSE_DAYS=14
# local (a folder per bot) | host (the user's own machine; also needs consent per bot in the app) | docker
ORBIS_COMPUTER_PROVIDER=local
ORBIS_LOG_LEVEL=info

# Bot computers: Chromium for the local browser tools (empty = Playwright's own,
# `npx playwright install chromium`), and the docker CLI for the docker provider.
ORBIS_BROWSER_EXECUTABLE=
ORBIS_DOCKER=docker

# CLI and MCP bridge
ORBIS_URL=http://127.0.0.1:7420
ORBIS_RUN_TOKEN=

# Optional API brains (bots can also store their own key as a secret)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model servers for the ollama and lmstudio brains (these are the defaults)
ORBIS_OLLAMA_URL=http://127.0.0.1:11434/v1
ORBIS_LMSTUDIO_URL=http://127.0.0.1:1234/v1

# Voice input where the browser cannot transcribe (desktop app, Firefox): any
# OpenAI-compatible /audio/transcriptions service. Settings → Voice overrides
# these; with none set and OPENAI_API_KEY present, OpenAI's is used.
ORBIS_TRANSCRIBE_URL=
ORBIS_TRANSCRIBE_MODEL=
ORBIS_TRANSCRIBE_API_KEY=
